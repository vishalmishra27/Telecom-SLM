APP_NAME=Telecom RCA Intelligence
APP_ENV=development
# Use * to allow frontend access from any host/port.
FRONTEND_ORIGINS=*

# Neo4j Desktop, Aura, or server connection
NEO4J_URI=neo4j://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=replace_me
NEO4J_DATABASE=neo4j

# Choose openai, ollama, or kg for answer structuring.
ANSWER_LLM_PROVIDER=openai

# OpenAI is optional. Without it, deterministic grounded answers are used.
OPENAI_API_KEY=replace_me
OPENAI_MODEL=gpt-5-mini
# Lower values keep answers more stable and less creative.
OPENAI_TEMPERATURE=0.2

# Ollama uses its OpenAI-compatible endpoint. Change model to one you have pulled.
OLLAMA_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.1

# Keep true for demonstrations before live credentials are configured.
ALLOW_DEMO_FALLBACK=true

# Stores asked questions and answers; repeated exact questions are detected.
CONVERSATION_MEMORY_ENABLED=true
CONVERSATION_MEMORY_DIR=../.chroma_conversations
